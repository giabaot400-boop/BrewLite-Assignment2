@startuml activity-checkout
title BrewLite — Task 2.1: Activity diagram — Đặt hàng và thanh toán (end-to-end)
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 13
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #5B4636
skinparam ActivityBackgroundColor #F9F2E9
skinparam ActivityBorderColor #80644F
skinparam ActivityDiamondBackgroundColor #FFF3D6
skinparam ActivityDiamondBorderColor #80644F
skinparam swimlaneTitleFontStyle bold
skinparam swimlaneWidth same

|Khách hàng|
start
:Chọn món, size, topping\nvà thêm vào giỏ;

|Next.js UI / BFF|
:Hiển thị giỏ hàng\nvà tổng tiền dự kiến;

|Khách hàng|
:Nhấn "Đặt hàng";

|Next.js UI / BFF|
if (Đã đăng nhập?) then (chưa)
  :Giữ nguyên giỏ,\nchuyển tới trang đăng nhập;
  |Khách hàng|
  :Đăng nhập / đăng ký;
  note right
    Đăng nhập xong **không** tự gửi đơn;
    khách quay lại giỏ và nhấn "Đặt hàng"
  end note
  stop
else (rồi)
endif

:Lưu yêu cầu tạo đơn\n(khóa idempotency + nội dung);
:Gửi POST /orders kèm JWT\n(BFF kiểm tra Origin và phiên);

|NestJS API|
if (JWT hợp lệ và dữ liệu\nđúng định dạng?) then (không)
  :Trả 401 / 400;
  |Next.js UI / BFF|
  :Báo lỗi, giữ giỏ;
  stop
else (có)
endif

|PostgreSQL|
:Mở transaction;
:Đọc giá hiện hành và tồn kho\ntừng sản phẩm;

|NestJS API|
if (Còn đủ hàng\nvà giá khớp?) then (không)
  |PostgreSQL|
  :Rollback;
  |Next.js UI / BFF|
  :Báo "hết hàng" hoặc "giá thay đổi";
  |Khách hàng|
  :Cập nhật giỏ rồi đặt lại\n(hoặc rời đi);
  stop
else (có)
endif

|PostgreSQL|
:Tạo Order PENDING, OrderItem;
:Giữ kho 15 phút (StockReservation)\nvà commit;

|Next.js UI / BFF|
:Đọc lại đơn,\nhiển thị tổng tiền chính thức;

|Khách hàng|
repeat
  :Chọn Ví hoặc Thẻ mô phỏng\nvà xác nhận thanh toán;

  |Next.js UI / BFF|
  :Lưu owner, khóa và nội dung thanh toán\n(bất biến cho lần thử này);
  repeat
    :Gửi POST /payments (Bearer token)\nkèm đúng khóa và nội dung đã lưu;

    |NestJS API|
    :Xác thực JWT, kiểm tra chủ đơn;
    if (Khóa này đã có attempt\nđã commit?) then (rồi)
      :Replay attempt đã lưu\n(không gọi mock, không lặp tác động kho/điểm);
    else (chưa: request trước chưa tới\nserver hoặc đã rollback)
      |PostgreSQL|
      :Khóa dòng Order, kiểm tra trạng thái,\nhạn thanh toán và dữ liệu giữ kho;
      |NestJS API|
      if (Đơn còn thanh toán được?) then (không)
        :Từ chối: hết hạn, đã hủy, đã trả\nhoặc đơn legacy thiếu dữ liệu;
        |Next.js UI / BFF|
        :Đọc lại đơn và thông báo\ntrạng thái hiện tại;
        stop
      else (còn)
      endif
      :PaymentService (mock) quyết định\nkết quả thanh toán;
      |PostgreSQL|
      if (Thanh toán thành công?) then (thành công)
        :Ghi Payment SUCCEEDED, Order PAID,\ntrừ kho thật, cộng điểm thưởng;
      else (thất bại)
        :Ghi Payment FAILED,\nOrder PAYMENT_FAILED, giữ kho đến hạn;
      endif
      note right
        Thử lại từ PAYMENT_FAILED (khóa mới):
        qua PENDING rồi ra kết quả cuối
        trong **cùng một** transaction
      end note
      :Commit transaction;
    endif

    |Next.js UI / BFF|
    if (Nhận được phản hồi?) then (có)
      :Đọc lại đơn hiện tại;
    else (không: mất mạng, timeout)
      :Chưa rõ kết quả: giữ nguyên owner,\nkhóa và nội dung; chưa kết luận FAILED\nvà chưa cho khóa mới;
    endif
  repeat while (Chưa rõ kết quả và\nkhách chủ động gửi lại?) is (có: cùng khóa,\ncùng nội dung) not (không)

  if (Đã có kết quả xác nhận?) then (chưa)
    :Giữ recovery chưa rõ cho lần mở sau;
    stop
  else (rồi)
  endif

  |Khách hàng|
  if (Đơn đã thanh toán?) then (rồi)
    :Xem thông báo thành công\nvà mã đơn;
    stop
  else (chưa)
    :Xem thông báo thất bại;
  endif
repeat while (FAILED đã xác nhận, không còn\nrecovery chưa rõ, đơn còn hạn\nvà khách muốn thử lại?) is (có: khóa mới) not (không)

|Next.js UI / BFF|
:Giữ giỏ hàng,\nđơn chờ hết hạn;
|Khách hàng|
stop
@enduml
