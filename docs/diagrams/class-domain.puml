@startuml class-domain
title BrewLite — Task 2.3: Domain class diagram
top to bottom direction
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 13
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #5B4636
skinparam classBorderColor #80644F
skinparam classBackgroundColor #F9F2E9
skinparam nodesep 50
skinparam ranksep 60
hide circle
hide methods

class User {
  id: String
  email: String
  passwordHash: String
  loyaltyPoints: Integer
  createdAt: DateTime
}

class Product {
  id: String
  name: String
  description: String
  price: Integer
  imageUrl: String
  stock: Integer
  reservedStock: Integer
  stockVersion: Integer
}

class Topping {
  id: String
  name: String
  price: Integer
}

class Order {
  id: String
  status: OrderStatus
  subtotal: Integer
  discountTotal: Integer
  total: Integer
  paymentDeadline: DateTime
  paidAt: DateTime [0..1]
  cancelReason: String [0..1]
  version: Integer
  createdAt: DateTime
}

class OrderItem {
  id: String
  productName: String
  size: String
  basePrice: Integer
  sizeExtraPrice: Integer
  unitPrice: Integer
  qty: Integer
  lineTotal: Integer
}

class OrderItemTopping {
  name: String
  price: Integer
}

class Payment {
  id: String
  method: PaymentMethod
  amount: Integer
  status: PaymentStatus
  failureCode: String [0..1]
  refundedAmount: Integer
  createdAt: DateTime
  resolvedAt: DateTime
}

class Promotion {
  id: String
  code: String
  active: Boolean
  startsAt: DateTime
  endsAt: DateTime
  minimumSubtotal: Integer
  percent: Integer
  maxDiscountAmount: Integer
}

class LoyaltyTransaction {
  id: String
  points: Integer
  createdAt: DateTime
  reversedAt: DateTime [0..1]
}

class StockReservation {
  id: String
  qty: Integer
  state: ReservationState
  createdAt: DateTime
  resolvedAt: DateTime [0..1]
}

enum OrderStatus <<enumeration>> {
  PENDING
  PAYMENT_FAILED
  PAID
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentStatus <<enumeration>> {
  SUCCEEDED
  FAILED
}

enum PaymentMethod <<enumeration>> {
  WALLET
  CARD
}

enum ReservationState <<enumeration>> {
  ACTIVE
  CONSUMED
  RELEASED
  RETURNED
}

User "1" -- "0..*" Order : đặt
Order "1" *-- "1..*" OrderItem : gồm
OrderItem "1" *-- "0..*" OrderItemTopping : topping đã chọn
Product "1" <-- "0..*" OrderItem : bán
Topping "1" <-- "0..*" OrderItemTopping : theo
Product "0..*" -- "0..*" Topping : cho phép
Order "1" -- "0..*" Payment : các lần thanh toán
Promotion "0..1" <-- "0..*" Order : áp dụng
User "1" -- "0..*" LoyaltyTransaction : nhận điểm
Order "1" -- "0..1" LoyaltyTransaction : phát sinh
Order "1" *-- "0..*" StockReservation : giữ kho
Product "1" <-- "0..*" StockReservation : giữ cho

Order ..> OrderStatus
Payment ..> PaymentStatus
Payment ..> PaymentMethod
StockReservation ..> ReservationState

note bottom of Order
  Order có nhiều Payment FAILED nhưng tối đa một SUCCEEDED.
  Payment.amount = Order.total; Payment và LoyaltyTransaction cùng chủ với Order.
  OrderItem / OrderItemTopping là bản chụp tên và giá lúc đặt.
  Giữ kho chỉ áp dụng cho Product, không áp dụng cho Topping.
end note
@enduml
