@startuml
title BrewLite Assignment 2 — Production deployment (PROPOSED)
top to bottom direction
skinparam componentStyle uml2
skinparam defaultFontSize 14
skinparam nodesep 35
skinparam ranksep 45

node "Client device" {
  artifact "Browser / PWA" as browser
}

cloud "GitHub — A2 source and CI" {
  artifact "BrewLite-Assignment2\nApproved A2 commit SHA" as repo

  node "GitHub Actions runner" {
    artifact "Quality gate\nInstall / Lint / Typecheck\nUnit / Setup tests / Build" as gate
    artifact "Build Web/API images\nTag by approved A2 SHA" as build
    artifact "Release approval\nDeploy / Smoke / Rollback" as cd
  }

  node "GHCR — proposed registry" as registry {
    artifact "A2 Web image\nSHA tag + digest" as webImage
    artifact "A2 API image\nSHA tag + digest" as apiImage
  }
}

cloud "Railway — dedicated A2 production environment" {
  node "Railway HTTPS Edge" as edge

  node "Web service" as web {
    artifact "Next.js UI + BFF\nTarget: apps/web/Dockerfile\nPort: configured Web PORT" as next
  }

  node "API service" as api {
    artifact "NestJS modules\nTarget: apps/api/Dockerfile\nMock PaymentService inside API\nPort: configured API PORT" as nest
  }

  node "Database service" {
    database "PostgreSQL 17\nA2 database / private only" as pg
  }

  node "Persistent Railway Volume" {
    artifact "PostgreSQL data directory" as data
  }

  node "API pre-deploy execution\nTemporary, not a fourth service" {
    artifact "prisma migrate deploy\nApproved API image / private DB" as migrate
  }

  node "Platform operations" {
    artifact "A2 environment variables\nSecrets / private service URLs" as config
    artifact "Startup health checks\nWeb: GET /\nAPI: GET /health" as health
    artifact "Application logs\nstdout / stderr\nNo tokens or secrets" as logs
  }
}

browser --> edge : HTTPS / 443
edge --> next : HTTP / Web target port
next --> nest : Private HTTP / API PORT
nest --> pg : Private PostgreSQL / 5432
pg -- data : Persistent storage

repo --> gate : PR and release checks
gate --> build : Only after PASS
build --> webImage : Push image
build --> apiImage : Push image
build --> cd : Record SHA and digests
cd ..> web : Approved Web image digest
cd ..> api : Approved API image digest
webImage ..> web : Image pull
apiImage ..> api : Image pull
apiImage ..> migrate : Same approved API image
migrate --> pg : Private migration connection

config ..> next
config ..> nest
health ..> next
health ..> nest
next ..> logs
nest ..> logs

note bottom of registry
GHCR is a proposal pending B review.
Registry authentication, Railway image deployment,
pre-deploy and rollback must be verified.
Do not enable a second deployment path bypassing CI.
end note

note bottom of web
Only Web has a public HTTPS domain.
API and PostgreSQL have no public TCP endpoint.
External API/health evidence through BFF
must be agreed and implemented before delivery.
end note

legend bottom
PROPOSED — no A2 production deployment is claimed.
A2 Dockerfiles and pipeline are not yet implemented at baseline d0a92b9.
Local: separate A2 checkout/config/database; Compose is local only.
CI: isolated test database, no production DB access during image build.
Production: dedicated A2 services, secrets and persistent volume.
A1 Compose evidence is reference only.
endlegend
@enduml