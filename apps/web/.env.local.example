# api: tích hợp backend A2 thật. fixture: chỉ dùng khi chủ động dựng UI.
NEXT_PUBLIC_PRODUCTS_SOURCE=api
BACKEND_INTERNAL_URL=http://localhost:3001
APP_ORIGIN=http://localhost:3000
AUTH_COOKIE_NAME=brewlite_a2_session

# Ban ban giao dung checkout S3. Chay migration va chuan bi ton kho truoc khi start.
# Cau hinh dang co khong bi npm run setup ghi de; giu v2 sau khi storage da chuyen.
CHECKOUT_V2_ENABLED=1
