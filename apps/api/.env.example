PORT=3001
MOCK_PAYMENT_OUTCOME=SUCCEEDED
DEMO_WORKFLOW_ENABLED=false
FRONTEND_ORIGIN=http://localhost:3000
# Database local riêng của A2; thay thông tin mẫu trước migration/seed.
DATABASE_URL=postgresql://brewlite:CHANGE_ME@localhost:5432/brewlite_a2?schema=public
# npm run setup sinh giá trị ngẫu nhiên khi tạo apps/api/.env mới.
AUTH_JWT_SECRET=GENERATE_ON_SETUP
